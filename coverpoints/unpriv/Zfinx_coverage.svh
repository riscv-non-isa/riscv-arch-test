`endif
function void zfinx_sample(int hart, int issue, ins_t ins);

    case (traceDataQ[hart][issue][0].inst_name)
        "fadd.s"     : begin
            Zfinx_fadd_s_cg.sample(ins);
        end
        "fclass.s"     : begin
            Zfinx_fclass_s_cg.sample(ins);
        end
        "fcvt.s.w"     : begin
            Zfinx_fcvt_s_w_cg.sample(ins);
        end
        "fcvt.s.wu"     : begin
            Zfinx_fcvt_s_wu_cg.sample(ins);
        end
        "fcvt.w.s"     : begin
            Zfinx_fcvt_w_s_cg.sample(ins);
        end
        "fcvt.wu.s"     : begin
            Zfinx_fcvt_wu_s_cg.sample(ins);
        end
        "fdiv.s"     : begin
            Zfinx_fdiv_s_cg.sample(ins);
        end
        "feq.s"     : begin
            Zfinx_feq_s_cg.sample(ins);
        end
        "fle.s"     : begin
            Zfinx_fle_s_cg.sample(ins);
        end
        "flt.s"     : begin
            Zfinx_flt_s_cg.sample(ins);
        end
        "fmadd.s"     : begin
            Zfinx_fmadd_s_cg.sample(ins);
        end
        "fmax.s"     : begin
            Zfinx_fmax_s_cg.sample(ins);
        end
        "fmin.s"     : begin
            Zfinx_fmin_s_cg.sample(ins);
        end
        "fmsub.s"     : begin
            Zfinx_fmsub_s_cg.sample(ins);
        end
        "fmul.s"     : begin
            Zfinx_fmul_s_cg.sample(ins);
        end
        "fnmadd.s"     : begin
            Zfinx_fnmadd_s_cg.sample(ins);
        end
        "fnmsub.s"     : begin
            Zfinx_fnmsub_s_cg.sample(ins);
        end
        "fsgnj.s"     : begin
            Zfinx_fsgnj_s_cg.sample(ins);
        end
        "fsgnjn.s"     : begin
            Zfinx_fsgnjn_s_cg.sample(ins);
        end
        "fsgnjx.s"     : begin
            Zfinx_fsgnjx_s_cg.sample(ins);
        end
        "fsqrt.s"     : begin
            Zfinx_fsqrt_s_cg.sample(ins);
        end
        "fsub.s"     : begin
            Zfinx_fsub_s_cg.sample(ins);
        end
`ifdef UDB_MXLEN_64
        "fcvt.l.s"     : begin
            Zfinx_fcvt_l_s_cg.sample(ins);
        end
        "fcvt.lu.s"     : begin
            Zfinx_fcvt_lu_s_cg.sample(ins);
        end
        "fcvt.s.l"     : begin
            Zfinx_fcvt_s_l_cg.sample(ins);
        end
        "fcvt.s.lu"     : begin
            Zfinx_fcvt_s_lu_cg.sample(ins);
        end
`endif
        default: ; // a case needs at least one item, and some configurations select none
    endcase
endfunction
